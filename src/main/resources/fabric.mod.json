{
  "schemaVersion": 1,
  "name": "EasierCrafting updated",
  "id": "easiercrafting-updated",
  "version": "${version}",
  "environment": "client",
  "entrypoints": {
    "client": [ "de.guntram.mcmod.easiercrafting.EasierCrafting" ],
    "modmenu": ["de.guntram.mcmod.easiercrafting.modConfig.ModMenuHandler"]
  },
  "mixins": [
    "mixins.easiercrafting.json"
  ],
  "depends": {
