  "description": "One-click Crafting updated",
  "icon": "icon.png",
  "authors": [ "Giselbaer","CCPCT"],
  "contact": {
    "homepage": "https://modrinth.com/mod/easiercrafting-updated",
    "sources": "https://github.com/CCPCT/EasierCrafting-updated",
    "issues": "https://github.com/CCPCT/EasierCrafting-updated/issues"
  }
